{
  "name": "babyzilla",
  "version": "0.19.0",
  "description": "70-99% context compression for OpenCode v2: ContextPack modules, per-request budgeting, tool-result compaction, and a reversible ledger — old steps shrink to one-liners you can `recall` byte-exactly.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "bin": {
    "babyzilla": "bin/babyzilla.mjs"
  },
  "files": [
    "pet/",
    "apps/pet/",
    "assets/pet/sprites/",
    "assets/pet/pet-data.json",
    "assets/pet/gallery.html",
    "assets/pet/gallery.css",
    "assets/pet/gallery-data.js",
    "index.js",
    "lib/",
    "bin/",
    "bench/",
    "test/",
    "README.md",
    "CHANGELOG.md",
    "AGENT-INSTALL.md",
    "docs/",
    "examples/"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context",
    "compaction",
    "context-window",
    "llm",
    "tokens",
    "token-savings",
    "prompt-caching",
    "contextpack",
    "ai-agent"
  ],
  "license": "MIT",
  "homepage": "https://github.com/StibaDu/babyzilla#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StibaDu/babyzilla.git"
  },
  "bugs": {
    "url": "https://github.com/StibaDu/babyzilla/issues"
  }
}
